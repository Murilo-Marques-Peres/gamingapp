<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/todayWind"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".TodayWindow">

    <!-- Container do Topo (Título e Contador de Horas) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/dados_de_hoje"
            android:textSize="20sp"
            android:textStyle="bold" />

        <!-- NOVO: Contador que exibe o total de horas jogadas no dia -->
        <TextView
            android:id="@+id/txtTotalHorasHoje"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/tempo_total_jogado_hoje_00h_00m2"
            android:textSize="16sp"
            android:textColor="#555555"
            android:layout_marginTop="4dp"
            android:textStyle="italic" />

    </LinearLayout>

    <!-- RecyclerView Ajustado para o ID do Java (recyclerViewHoje) -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvListagemToday"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"/>

    <!-- Botão Adicionar Mais -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnAdicionarMais"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:backgroundTint="@null"
            android:background="@drawable/button_edition"
            android:text="@string/noe"
            android:textSize="20sp" />
        <Button
            android:id="@+id/btnExcluirItem"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:backgroundTint="@null"
            android:background="@drawable/button_edition"
            android:text="Remover"
            android:textSize="20sp"
            >

        </Button>


    </LinearLayout>


</LinearLayout>
